import sys
from collections import deque, defaultdict, Counter
from heapq import heappush, heappop
import bisect


def main() -> None:
    data = sys.stdin.buffer.read().split()
    it = iter(data)
    t = int(next(it))
    out = []

    # audrey's favorite has to be substrings of 123456789, make list of them
    favorites = []
    base = "123456789"

    # make substrings length 1 to 9
    for length in range(1, 10):
        for i in range(10 - length):
            substring = base[i : i + length]
            favorites.append(int(substring))

    # sort
    favorites.sort()

    for test in range(t):
        n = int(next(it))
        i = bisect.bisect_left(favorites, n)

        if i == len(favorites):
            out.append(str(favorites[-1]))
        else:
            out.append(str(favorites[i]))

    sys.stdout.write("\n".join(map(str, out)) + "\n")


main()
